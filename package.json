{
  "name": "turbine-mobile",
  "version": "0.1.0",
  "description": "Native React Native Companion App for Turbine",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "web": "expo start --web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.19",
    "expo-camera": "~57.0.6",
    "expo-dev-client": "~57.0.18",
    "expo-haptics": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "~0.21.3",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.18",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "private": true,
  "packageManager": "pnpm@10.27.0"
}
